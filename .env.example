# ---------------------------------------------------------------
# ShopFlow environment configuration
# Copy this file to .env and replace the placeholder values.
# Never commit your real .env file.
# ---------------------------------------------------------------

# --- Application -----------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL of the storefront (used for links inside emails)
APP_URL=http://localhost:3000

# --- PostgreSQL ------------------------------------------------
# Either set DATABASE_URL ...
DATABASE_URL=postgres://shopflow:your_db_password@localhost:5432/shopflow
# ... set to "true" for hosted databases that require TLS (Render, Neon, Supabase, ...)
DATABASE_SSL=false
# Max connections in the pool
DATABASE_POOL_MAX=10

# Database used by the automated tests (WILL BE WIPED by the tests)
TEST_DATABASE_URL=postgres://shopflow:your_db_password@localhost:5432/shopflow_test

# --- Authentication --------------------------------------------
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=Store Administrator

# --- Email (Resend) --------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain verified in Resend
# (use onboarding@resend.dev while testing)
EMAIL_FROM=ShopFlow <orders@your-verified-domain.com>
EMAIL_REPLY_TO=support@your-verified-domain.com

# --- Email worker ----------------------------------------------
# How often the worker polls for pending jobs (milliseconds)
EMAIL_WORKER_POLL_INTERVAL_MS=5000
# Jobs claimed per polling cycle
EMAIL_WORKER_BATCH_SIZE=10
# Total attempts per job (1 initial attempt + 3 retries)
EMAIL_MAX_ATTEMPTS=4
# Base retry delay; grows exponentially: 30s, 2m, 8m, ...
EMAIL_RETRY_BASE_DELAY_MS=30000
# A job stuck in "processing" longer than this is considered abandoned
# by a crashed worker and is released for another attempt
EMAIL_JOB_LOCK_TIMEOUT_MS=300000
# Run the worker inside the web process (handy for single-instance hosting)
RUN_WORKER_IN_PROCESS=false
